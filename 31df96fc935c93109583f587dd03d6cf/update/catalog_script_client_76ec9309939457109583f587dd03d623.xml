        <name>Validate Session Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit() {

    var sessionDate = g_form.getValue('session_date');

    var selectedDate = sessionDate.substring(0, 10);

    var today = new Date();
    var todayString = today.getFullYear() + '-' +
        ('0' + (today.getMonth() + 1)).slice(-2) + '-' +
        ('0' + today.getDate()).slice(-2);

    if (selectedDate < todayString) {
        g_form.addErrorMessage(
            'The session date cannot be earlier than today.'
        );

        return false;
    }

    return true;
}]]></script>
